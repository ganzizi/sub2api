#!/usr/bin/env python3
# 测试夹具：只实现 BSD stat -f '%Lp' / '%u'，让权限检查在 Linux 上结果一致。
import os
import sys


def main(argv):
    if len(argv) == 4 and argv[1] == "-f":
        fmt, path = argv[2], argv[3]
        st = os.stat(path)
        if fmt == "%Lp":
            sys.stdout.write(format(st.st_mode & 0o777, "o"))
            return 0
        if fmt == "%u":
            sys.stdout.write(str(st.st_uid))
            return 0
    sys.stderr.write("unsupported stat invocation\n")
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
